---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config/site';
---
<Base title="Payment successful" description="Your enrolment is confirmed.">
  <section class="container-x flex flex-1 items-center justify-center py-24">
    <div class="card max-w-xl text-center">
      <span class="mx-auto inline-flex rounded-full bg-pass/15 p-4 text-pass"><Icon name="check" class="h-8 w-8" /></span>
      <h1 class="mt-6 text-3xl font-bold text-ink">You are in!</h1>
      <p class="mt-3 text-muted-strong">Payment received for <strong id="pay-course" class="text-ink">your course</strong>.</p>
      <p class="mt-2 text-sm text-muted">Payment ID: <span id="pay-id" class="font-mono text-ink">-</span></p>
      <p class="mt-6 text-muted">Razorpay has emailed your receipt. We will reach out on WhatsApp or email within one working day with your batch details and joining link. Keep the payment ID handy if you contact us.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={site.social.whatsapp} target="_blank" rel="noopener" class="btn-primary">Message us on WhatsApp</a>
        <a href="/library" class="btn-dark">Start with the free library</a>
      </div>
    </div>
  </section>
</Base>
<script>
  const p = new URLSearchParams(location.search);
  const c = p.get('course'), id = p.get('pid');
  if (c) document.getElementById('pay-course')!.textContent = c;
  if (id) document.getElementById('pay-id')!.textContent = id;
</script>
