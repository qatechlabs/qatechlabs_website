---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';
import { getCollection, render } from 'astro:content';
import { site, batches } from '../../config/site';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  return courses.map((c) => ({ params: { slug: c.id }, props: { course: c } }));
}
const { course } = Astro.props;
const d = course.data;
const { Content } = await render(course);
const courseBatches = batches.filter((b) => b.course === course.id && new Date(b.starts) >= new Date());
const enrolHref = d.paymentLink || `/contact?course=${encodeURIComponent(d.shortTitle)}`;
const fmt = (s: string) => new Date(s).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={d.shortTitle} description={d.summary} type="article">
  <section class="bg-base py-16 text-white">
    <div class="container-x grid gap-10 lg:grid-cols-3">
      <div class="min-w-0 lg:col-span-2">
        <a href="/courses" class="text-sm text-slate-400 hover:text-white">← All courses</a>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <span class="eyebrow-dark">{d.level}</span>
          <span class="text-sm text-slate-400">{d.duration}</span>
        </div>
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight sm:text-5xl">{d.title}</h1>
        <p class="mt-5 max-w-2xl text-lg text-slate-300">{d.summary}</p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {d.tools.map((t) => <li class="rounded-md border border-white/15 bg-white/5 px-2.5 py-1 font-mono text-xs">{t}</li>)}
        </ul>
      </div>
      <aside class="rounded-2xl border border-white/10 bg-surface p-6 shadow-glow lg:sticky lg:top-24 lg:self-start">
        <p class="text-sm text-slate-400">Course fee</p>
        <p class="mt-1 text-4xl font-extrabold">${d.price} {d.originalPrice && <span class="ml-1 text-lg font-normal text-dim line-through">${d.originalPrice}</span>}</p>
        <p class="mt-1 text-xs text-dim">{site.payments.currencyNote}</p>
        <a href={enrolHref} target={d.paymentLink ? '_blank' : undefined} rel={d.paymentLink ? 'noopener' : undefined} class="btn-primary mt-6 w-full">Enrol now</a>
        <a href={`/contact?course=${encodeURIComponent(d.shortTitle)}`} class="btn-ghost-light mt-3 w-full">Ask a question</a>
        <ul class="mt-6 space-y-2 text-sm text-slate-300">
          <li class="flex gap-2"><Icon name="check" class="h-5 w-5 shrink-0 text-lab-400" />Live sessions + lifetime recordings</li>
          <li class="flex gap-2"><Icon name="check" class="h-5 w-5 shrink-0 text-lab-400" />Weekly code review</li>
          <li class="flex gap-2"><Icon name="check" class="h-5 w-5 shrink-0 text-lab-400" />Mock interview included</li>
          <li class="flex gap-2"><Icon name="check" class="h-5 w-5 shrink-0 text-lab-400" />Certificate of completion</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="container-x grid gap-12 py-14 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <h2 class="text-2xl font-bold text-ink">What you will be able to do</h2>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
        {d.outcomes.map((o) => <li class="flex gap-3 rounded-xl border border-line p-4 text-sm text-muted-strong"><Icon name="check" class="h-5 w-5 shrink-0 text-lab-400" />{o}</li>)}
      </ul>
      <article class="prose-ql mt-6"><Content /></article>
    </div>
    <div>
      <h2 class="text-xl font-bold text-ink">Upcoming batches</h2>
      {courseBatches.length ? courseBatches.map((b) => (
        <div class="card mt-4">
          <p class="font-semibold text-ink">Starts {fmt(b.starts)}</p>
          <p class="mt-1 text-sm text-muted">{b.schedule}</p>
          <p class="mt-1 text-sm text-muted">{b.duration} · {b.mode}</p>
          <p class="mt-2 text-xs font-semibold text-lab-300">{b.seats} seats</p>
          <a href={enrolHref} target={d.paymentLink ? '_blank' : undefined} rel={d.paymentLink ? 'noopener' : undefined} class="btn-dark mt-4 w-full">Reserve a seat</a>
        </div>
      )) : (
        <div class="card mt-4">
          <p class="text-sm text-muted">No batch scheduled yet. Join the waitlist and we will tell you first.</p>
          <a href={`/contact?course=${encodeURIComponent(d.shortTitle)}&intent=waitlist`} class="btn-dark mt-4 w-full">Join the waitlist</a>
        </div>
      )}
      <a href="/batches" class="mt-4 block text-sm font-semibold text-lab-300 hover:underline">See all batches →</a>
    </div>
  </section>
  <CTA title="Questions before you enrol?" body="We reply within a day, usually faster. Tell us about your background and we will say honestly whether this course is right for you." />
</Base>
