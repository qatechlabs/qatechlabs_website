---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CourseCard from '../components/CourseCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';
import LiveCode from '../components/LiveCode.astro';
import CodeRain from '../components/CodeRain.astro';
import Marquee from '../components/Marquee.astro';
import Stats from '../components/Stats.astro';
import FAQ from '../components/FAQ.astro';
import { getCollection } from 'astro:content';
import { site, batches } from '../config/site';

const courses = (await getCollection('courses')).sort((a, b) => a.data.order - b.data.order);
const featured = courses.filter((c) => c.data.featured).slice(0, 3);
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const nextBatch = batches.filter((b) => new Date(b.starts) >= new Date()).sort((a, b) => a.starts.localeCompare(b.starts))[0];
const fmt = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const pillars = [
  { icon: 'book', title: 'The QA Library', body: 'Free, structured guides on every testing discipline plus AI for testers. Start anywhere, follow a path.', href: '/library', cta: 'Browse the library' },
  { icon: 'play', title: 'Free recordings', body: 'Full sessions from past batches, uploaded for anyone to watch. No sign-up wall.', href: '/batches#recordings', cta: 'Watch now' },
  { icon: 'users', title: 'Live courses', body: 'Small live batches where you build a real app and a real framework from scratch, with weekly code review.', href: '/courses', cta: 'See courses' },
  { icon: 'mic', title: 'Interview practice', body: 'Mock interviews, question banks and timed practice at interview.qatechlabs.com.', href: site.interviewUrl, cta: 'Practise', external: true },
];

const topics = [
  { name: 'Manual Testing', icon: 'clipboard' },
  { name: 'Playwright + TypeScript', icon: 'bolt' },
  { name: 'API Testing', icon: 'server' },
  { name: 'Database & SQL', icon: 'database' },
  { name: 'Performance', icon: 'gauge' },
  { name: 'AI for QA', icon: 'sparkles' },
];
---
<Base title={site.name}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-base text-white">
    <CodeRain />
    <div class="grid-bg absolute inset-0" aria-hidden="true"></div>
    <div class="animate-aurora absolute -left-40 top-10 h-[32rem] w-[32rem] rounded-full bg-accent-600/30 blur-3xl" aria-hidden="true"></div>
    <div class="animate-aurora absolute -right-40 bottom-0 h-[28rem] w-[28rem] rounded-full bg-lab-600/25 blur-3xl" style="animation-delay:-7s" aria-hidden="true"></div>
    <div class="container-x relative grid items-center gap-12 py-20 lg:grid-cols-12 lg:py-28">
      <div class="min-w-0 lg:col-span-6">
        {nextBatch && (
          <a href="/batches" class="eyebrow hover:bg-accent-500/20">
            <span class="h-2 w-2 animate-pulse rounded-full bg-lab-400"></span>
            Next live batch starts {fmt(nextBatch.starts)}
          </a>
        )}
        <h1 class="mt-6 text-4xl font-bold leading-[1.05] sm:text-5xl lg:text-6xl">
          Learn QA the way it is <span class="text-gradient">actually done.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-muted-strong">
          A free library, free recordings and live courses for testers at every level. Manual, Playwright + TypeScript automation, API, database, performance, and AI for QA. You build a real application and a real framework from scratch, with people who have shipped them.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/library" class="btn-primary">Start learning free</a>
          <a href="/courses" class="btn-ghost-light">Explore live courses</a>
        </div>
      </div>
      <div class="min-w-0 lg:col-span-6">
        <div class="animate-float">
          <LiveCode />
        </div>
        <p class="mt-5 text-center text-xs text-dim">This is what week 4 looks like. Week 1 is “what is a variable?”</p>
      </div>
    </div>
  </section>

  <Marquee />

  <!-- Four pillars -->
  <section class="container-x py-16 sm:py-24">
    <div class="reveal"><SectionHeading eyebrow="One place for QA" title="Everything a tester needs, in one place" subtitle="Most of it is free. The live courses are for when you want to go deep with guidance." align="center" /></div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {pillars.map((p) => (
        <a href={p.href} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined} class="card group">
          <span class="inline-flex rounded-xl bg-accent-500/15 p-3 text-accent-300"><Icon name={p.icon} /></span>
          <h3 class="mt-5 text-lg font-bold text-ink">{p.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{p.body}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-lab-300 transition-all group-hover:gap-2">{p.cta} <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>

  <Stats />

  <!-- Topics strip -->
  <section class="border-y border-line bg-surface-2 py-10">
    <div class="container-x">
      <p class="text-center text-xs font-semibold uppercase tracking-wider text-dim">What we cover</p>
      <ul class="mt-6 flex flex-wrap justify-center gap-3">
        {topics.map((t) => (
          <li><a href="/library" class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-2 text-sm font-medium text-ink transition hover:border-accent-500"><Icon name={t.icon} class="h-4 w-4 text-lab-400" />{t.name}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Featured courses -->
  <section class="container-x py-16 sm:py-24">
    <div class="reveal flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading eyebrow="Live courses" title="Learn by building, not by watching" subtitle="Every course ends with something on your GitHub that you can walk an interviewer through." />
      <a href="/courses" class="btn-ghost shrink-0">All courses</a>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {featured.map((c) => <CourseCard course={c} />)}
    </div>
  </section>

  <!-- Why different -->
  <section class="relative overflow-hidden bg-surface-2 py-16 sm:py-24">
    <div class="absolute right-0 top-0 h-80 w-80 rounded-full bg-accent-600/15 blur-3xl" aria-hidden="true"></div>
    <div class="container-x relative grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="reveal">
        <SectionHeading dark eyebrow="Why QA Tech Labs" title="We teach from real problems, not slides" subtitle="Everything in our courses comes from projects we have shipped and bugs we have chased at 2 AM. Here is what that means for you." />
        <a href="/about" class="btn-primary mt-8">Meet the team</a>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2">
        {[
          { icon: 'code', t: 'Build an app end to end', b: 'You do not just test an app. You build one with an AI agent and MCP servers, so you understand what you are testing.' },
          { icon: 'bolt', t: 'Real-time project', b: 'One continuous project across the course, with sprints, code reviews and a CI pipeline, like a real job.' },
          { icon: 'mic', t: 'Interviews, rehearsed', b: 'Mock interviews, question banks and timed practice on interview.qatechlabs.com, included.' },
          { icon: 'brain', t: 'Experience, not theory', b: 'Every topic is taught through a problem we actually hit and how we solved it.' },
        ].map((f) => (
          <li class="card">
            <span class="inline-flex rounded-lg bg-lab-500/15 p-2 text-lab-300"><Icon name={f.icon} class="h-5 w-5" /></span>
            <h3 class="mt-4 font-bold text-ink">{f.t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{f.b}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Testimonials />

  <!-- Latest from the blog -->
  <section class="container-x py-16 sm:py-24">
    <div class="reveal flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading eyebrow="Blog" title="Latest from the lab" />
      <a href="/blog" class="btn-ghost shrink-0">All posts</a>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {posts.map((p) => (
        <a href={`/blog/${p.id}`} class="card group">
          <span class="text-xs font-semibold uppercase tracking-wider text-lab-300">{p.data.topic}</span>
          <h3 class="mt-3 text-lg font-bold text-ink group-hover:text-lab-300">{p.data.title}</h3>
          <p class="mt-2 text-sm text-muted">{p.data.description}</p>
          <p class="mt-4 text-xs text-dim">{p.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })} · {p.data.readingTime}</p>
        </a>
      ))}
    </div>
  </section>

  <FAQ />

  <CTA />
</Base>
