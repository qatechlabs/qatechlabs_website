---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../config/site';
const hasEndpoint = Boolean(site.formEndpoint);
---
<Base title="Contact" description="Ask about a course, book a free 15-minute call, request a resource or just say hello. We reply within a day.">
  <section class="bg-surface-2 py-16">
    <div class="container-x">
      <SectionHeading eyebrow="Contact" title="Talk to a human" subtitle="Ask about a course, request a free resource, or book a 15-minute call to figure out your path. We reply within one working day." />
    </div>
  </section>

  <section class="container-x grid gap-12 py-14 lg:grid-cols-3">
    <form id="contact-form" class="card lg:col-span-2" method="POST" action={hasEndpoint ? site.formEndpoint : `mailto:${site.email}`} enctype={hasEndpoint ? undefined : 'text/plain'}>
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block text-sm font-medium text-ink">Name
          <input required name="name" type="text" autocomplete="name" class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-base focus:border-lab-500 focus:outline-none focus:ring-2 focus:ring-lab-500/30" />
        </label>
        <label class="block text-sm font-medium text-ink">Email
          <input required name="email" type="email" autocomplete="email" class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-base focus:border-lab-500 focus:outline-none focus:ring-2 focus:ring-lab-500/30" />
        </label>
        <label class="block text-sm font-medium text-ink">WhatsApp / phone (optional)
          <input name="phone" type="tel" autocomplete="tel" class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-base focus:border-lab-500 focus:outline-none focus:ring-2 focus:ring-lab-500/30" />
        </label>
        <label class="block text-sm font-medium text-ink">I am interested in
          <select name="interest" id="interest" class="mt-1.5 w-full rounded-lg border border-line bg-surface px-3 py-2.5 text-base focus:border-lab-500 focus:outline-none focus:ring-2 focus:ring-lab-500/30">
            <option>Playwright + TypeScript</option>
            <option>Manual Testing</option>
            <option>API Testing</option>
            <option>Database Testing</option>
            <option>Performance Testing</option>
            <option>AI for QA</option>
            <option>A free resource</option>
            <option>Booking a 15-minute call</option>
            <option>Something else</option>
          </select>
        </label>
      </div>
      <label class="mt-5 block text-sm font-medium text-ink">Message
        <textarea required name="message" id="message" rows="5" class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-base focus:border-lab-500 focus:outline-none focus:ring-2 focus:ring-lab-500/30" placeholder="Tell us a little about your background and what you want to achieve."></textarea>
      </label>
      <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
      <input type="hidden" name="_subject" value="New enquiry from qatechlabs.com" />
      <button type="submit" class="btn-primary mt-6 w-full sm:w-auto">Send message</button>
      <p class="mt-3 text-xs text-dim">We never share your details. {!hasEndpoint && 'This opens your email app until the form service is connected.'}</p>
    </form>

    <aside class="space-y-4">
      <a href={site.social.whatsapp} target="_blank" rel="noopener" class="card flex items-start gap-4">
        <span class="rounded-xl bg-accent-500/15 p-3 text-lab-300"><Icon name="users" /></span>
        <span><span class="block font-bold text-ink">WhatsApp</span><span class="mt-1 block text-sm text-muted">Fastest for batch and pricing questions.</span></span>
      </a>
      <a href={`mailto:${site.email}`} class="card flex items-start gap-4">
        <span class="rounded-xl bg-accent-500/15 p-3 text-lab-300"><Icon name="book" /></span>
        <span><span class="block font-bold text-ink">Email</span><span class="mt-1 block text-sm text-muted">{site.email}</span></span>
      </a>
      <a href={site.interviewUrl} target="_blank" rel="noopener" class="card flex items-start gap-4">
        <span class="rounded-xl bg-accent-500/15 p-3 text-lab-300"><Icon name="mic" /></span>
        <span><span class="block font-bold text-ink">Interview practice</span><span class="mt-1 block text-sm text-muted">interview.qatechlabs.com ↗</span></span>
      </a>
    </aside>
  </section>
</Base>
<script>
  // Pre-fill from ?course= / ?resource= / ?intent=
  const params = new URLSearchParams(location.search);
  const interest = document.getElementById('interest') as HTMLSelectElement | null;
  const message = document.getElementById('message') as HTMLTextAreaElement | null;
  const course = params.get('course');
  const resource = params.get('resource');
  if (interest && course) {
    for (const opt of interest.options) if (opt.text === course) interest.value = opt.text;
    if (message) message.value = params.get('intent') === 'waitlist'
      ? `Please add me to the waitlist for ${course}.`
      : `I would like to enrol in ${course}. `;
  }
  if (interest && resource) {
    interest.value = 'A free resource';
    if (message) message.value = `Please send me: ${resource}`;
  }
</script>
