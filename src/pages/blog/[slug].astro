---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
---
<Base title={d.title} description={d.description} type="article">
  <article class="container-x max-w-3xl py-14">
    <a href="/blog" class="text-sm text-slate-500 hover:text-navy-900">← All posts</a>
    <span class="mt-6 block text-xs font-semibold uppercase tracking-wider text-lab-700">{d.topic}</span>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-navy-900 sm:text-4xl">{d.title}</h1>
    <p class="mt-4 text-lg text-slate-600">{d.description}</p>
    <p class="mt-4 text-sm text-slate-500">By {d.author} · {d.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })} · {d.readingTime}</p>
    <div class="prose-ql mt-10 border-t border-slate-200 pt-8"><Content /></div>
  </article>
  <CTA />
</Base>
