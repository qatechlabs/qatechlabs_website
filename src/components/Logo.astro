---
/**
 * QA Tech Labs mark: a "Q" drawn as a continuous test loop whose tail
 * becomes a check mark (quality), with a node at the top-right (AI / tech).
 * Gradient runs violet -> cyan, the brand accent.
 */
interface Props { class?: string; size?: number; wordmark?: boolean; light?: boolean }
const { class: cls = '', size = 36, wordmark = true } = Astro.props;
const id = 'qtl-' + Math.random().toString(36).slice(2, 7);
---
<a href="/" class={`group inline-flex items-center gap-2.5 ${cls}`} aria-label="QA Tech Labs home">
  <svg width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id={id} x1="6" y1="6" x2="42" y2="42" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#a78bfa" />
        <stop offset="1" stop-color="#22d3ee" />
      </linearGradient>
    </defs>
    <path d="M33.4 35.6A15 15 0 1 1 36.9 29.3" stroke={`url(#${id})`} stroke-width="4.5" stroke-linecap="round" />
    <path d="M24 26l6.5 6.5L45 18" stroke={`url(#${id})`} stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="39.5" cy="8.5" r="3.2" fill="#22d3ee" />
    <circle cx="39.5" cy="8.5" r="6" stroke="#22d3ee" stroke-opacity=".35" stroke-width="1.5" />
  </svg>
  {wordmark && <span class="font-display text-[19px] font-bold tracking-tight text-ink">QA Tech Labs</span>}
</a>
