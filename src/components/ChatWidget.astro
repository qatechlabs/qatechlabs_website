---
/**
 * Floating AI assistant. Talks to /api/chat (streamed text). Keeps the
 * conversation in sessionStorage for the tab only. Offers "Talk to a human"
 * links to the contact page and WhatsApp at all times.
 */
import { site } from '../config/site';
const starters = ['Which course should I start with?', 'When is the next batch?', 'Is the library really free?', 'Do you help with interviews?'];
---
<div id="chat" class="fixed bottom-5 left-5 z-40 sm:left-auto sm:right-24">
  <button id="chat-toggle" class="group flex items-center gap-2 rounded-full border border-accent-500/40 bg-surface/90 py-2 pl-2 pr-4 text-sm font-semibold text-ink shadow-lg shadow-accent-600/20 backdrop-blur transition hover:border-accent-400 hover:shadow-accent-500/40" aria-expanded="false" aria-controls="chat-panel">
    <span class="relative flex h-9 w-9 items-center justify-center rounded-full text-white" style="background: linear-gradient(135deg, var(--color-accent-500), var(--color-lab-600))">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8L12 3zM19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z"/></svg>
      <span class="absolute -right-0.5 -top-0.5 h-2.5 w-2.5 rounded-full bg-pass ring-2 ring-surface"></span>
    </span>
    Ask QA Tech Labs AI
  </button>

  <section id="chat-panel" class="hidden absolute bottom-16 left-0 flex h-[min(600px,calc(100vh-7rem))] w-[min(380px,calc(100vw-2.5rem))] flex-col overflow-hidden rounded-2xl border border-line bg-surface shadow-2xl shadow-black/50 sm:left-auto sm:right-0" role="dialog" aria-label="QA Tech Labs assistant">
    <header class="flex items-center gap-3 border-b border-line px-4 py-3">
      <span class="flex h-8 w-8 items-center justify-center rounded-full text-white" style="background: linear-gradient(135deg, var(--color-accent-500), var(--color-lab-600))">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8L12 3z"/></svg>
      </span>
      <div class="min-w-0 flex-1">
        <p class="text-sm font-bold text-ink">QA Tech Labs assistant</p>
        <p class="text-xs text-dim">Answers in seconds. Humans reply within a day.</p>
      </div>
      <button id="chat-close" class="rounded-md p-1 text-dim hover:text-ink" aria-label="Close chat">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </header>

    <div id="chat-log" class="flex-1 space-y-3 overflow-y-auto px-4 py-4 text-sm" aria-live="polite">
      <div class="chat-bot">Hi! I can help you pick a course, check batch dates, or find free resources. What are you looking for?</div>
      <div id="chat-starters" class="flex flex-wrap gap-2 pt-1">
        {starters.map((s) => <button type="button" class="chat-starter rounded-full border border-line bg-surface-2 px-3 py-1.5 text-xs text-muted-strong hover:border-accent-500 hover:text-ink">{s}</button>)}
      </div>
    </div>

    <div class="border-t border-line px-3 py-2">
      <div class="mb-2 flex gap-2 text-[11px]">
        <a href="/contact" class="rounded-full border border-line px-2.5 py-1 text-muted hover:border-accent-500 hover:text-ink">Talk to a human</a>
        <a href={site.social.whatsapp} target="_blank" rel="noopener" class="rounded-full border border-line px-2.5 py-1 text-muted hover:border-accent-500 hover:text-ink">WhatsApp</a>
        <button id="chat-reset" type="button" class="ml-auto text-dim hover:text-ink">Clear</button>
      </div>
      <form id="chat-form" class="flex items-end gap-2">
        <textarea id="chat-input" rows="1" required maxlength="2000" placeholder="Ask anything about QA Tech Labs…" class="max-h-28 flex-1 resize-none rounded-xl border border-line bg-surface-2 px-3 py-2 text-sm text-ink placeholder:text-dim focus:border-accent-500 focus:outline-none"></textarea>
        <button type="submit" id="chat-send" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl text-white disabled:opacity-50" style="background: linear-gradient(135deg, var(--color-accent-500), var(--color-lab-600))" aria-label="Send">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </form>
      <p class="mt-1.5 text-[10px] text-dim">AI can make mistakes. Prices and dates are confirmed on the course pages.</p>
    </div>
  </section>
</div>

<style is:global>
  .chat-bot, .chat-user { max-width: 88%; border-radius: 1rem; padding: .6rem .85rem; line-height: 1.5; white-space: pre-wrap; word-break: break-word; }
  .chat-bot { background: var(--color-surface-2); border: 1px solid var(--color-line); color: var(--color-muted-strong); border-bottom-left-radius: .3rem; }
  .chat-user { margin-left: auto; background: linear-gradient(135deg, rgb(139 92 246 / .9), rgb(6 182 212 / .9)); color: #fff; border-bottom-right-radius: .3rem; }
  .chat-bot a { color: var(--color-lab-300); text-decoration: underline; text-underline-offset: 2px; }
  .chat-typing span { display: inline-block; width: 6px; height: 6px; margin-right: 3px; border-radius: 9999px; background: var(--color-accent-400); animation: chatdot 1.2s infinite ease-in-out; }
  .chat-typing span:nth-child(2) { animation-delay: .15s } .chat-typing span:nth-child(3) { animation-delay: .3s }
  @keyframes chatdot { 0%, 80%, 100% { transform: scale(.6); opacity: .4 } 40% { transform: scale(1); opacity: 1 } }
</style>

<script>
  type Msg = { role: 'user' | 'assistant'; content: string };
  const $ = (id: string) => document.getElementById(id)!;
  const panel = $('chat-panel'), toggle = $('chat-toggle'), log = $('chat-log');
  const form = $('chat-form') as HTMLFormElement, input = $('chat-input') as HTMLTextAreaElement, send = $('chat-send') as HTMLButtonElement;
  const KEY = 'qtl-chat';
  let history: Msg[] = [];
  try { history = JSON.parse(sessionStorage.getItem(KEY) || '[]'); } catch {}

  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  const render = (s: string) =>
    esc(s)
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, (_m, t, u) => `<a href="${u}"${u.startsWith('http') ? ' target="_blank" rel="noopener"' : ''}>${t}</a>`)
      .replace(/(^|[\s(])(\/(?:courses|library|batches|resources|blog|contact|about)[\w\-\/#]*)/g, '$1<a href="$2">$2</a>')
      .replace(/(^|[\s(])(https?:\/\/[^\s)]+)/g, '$1<a href="$2" target="_blank" rel="noopener">$2</a>');

  const bubble = (role: Msg['role'], text = '') => {
    const el = document.createElement('div');
    el.className = role === 'user' ? 'chat-user' : 'chat-bot';
    el.innerHTML = role === 'user' ? esc(text) : render(text);
    log.appendChild(el); log.scrollTop = log.scrollHeight;
    return el;
  };
  for (const m of history) bubble(m.role, m.content);
  if (history.length) $('chat-starters').remove();

  const open = (o: boolean) => {
    panel.classList.toggle('hidden', !o);
    toggle.setAttribute('aria-expanded', String(o));
    if (o) input.focus();
  };
  toggle.addEventListener('click', () => open(panel.classList.contains('hidden')));
  $('chat-close').addEventListener('click', () => open(false));
  $('chat-reset').addEventListener('click', () => { history = []; sessionStorage.removeItem(KEY); location.reload(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') open(false); });
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); } });
  input.addEventListener('input', () => { input.style.height = 'auto'; input.style.height = Math.min(input.scrollHeight, 112) + 'px'; });
  document.querySelectorAll<HTMLButtonElement>('.chat-starter').forEach((b) => b.addEventListener('click', () => { input.value = b.textContent || ''; form.requestSubmit(); }));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text || send.disabled) return;
    document.getElementById('chat-starters')?.remove();
    input.value = ''; input.style.height = 'auto';
    history.push({ role: 'user', content: text }); bubble('user', text);
    send.disabled = true;
    const typing = bubble('assistant'); typing.className += ' chat-typing'; typing.innerHTML = '<span></span><span></span><span></span>';
    let reply = '';
    try {
      const res = await fetch('/api/chat', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ messages: history }) });
      if (!res.ok || !res.body) {
        const err = await res.json().catch(() => ({}));
        reply = err.error || 'Sorry, I could not answer that. Please use the contact page.';
        typing.classList.remove('chat-typing'); typing.innerHTML = render(reply);
      } else {
        typing.classList.remove('chat-typing'); typing.textContent = '';
        const reader = res.body.getReader(); const dec = new TextDecoder();
        for (;;) {
          const { value, done } = await reader.read();
          if (done) break;
          reply += dec.decode(value, { stream: true });
          typing.innerHTML = render(reply); log.scrollTop = log.scrollHeight;
        }
      }
    } catch {
      reply = 'Network hiccup. Please try again, or message us on the contact page.';
      typing.classList.remove('chat-typing'); typing.innerHTML = render(reply);
    }
    history.push({ role: 'assistant', content: reply });
    try { sessionStorage.setItem(KEY, JSON.stringify(history.slice(-20))); } catch {}
    send.disabled = false; input.focus();
  });
</script>
