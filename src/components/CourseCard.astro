---
import Icon from './Icon.astro';
import { formatPrice } from '../config/site';
import type { CollectionEntry } from 'astro:content';
interface Props { course: CollectionEntry<'courses'> }
const { course } = Astro.props;
const d = course.data;
---
<a href={`/courses/${course.id}`} class="card group flex flex-col">
  <div class="flex items-start justify-between gap-4">
    <span class="rounded-xl bg-surface p-3 text-lab-400"><Icon name={d.icon} /></span>
    <span class="rounded-full bg-surface-2 px-2.5 py-1 text-xs font-semibold text-ink">{d.level}</span>
  </div>
  <h3 class="mt-5 text-lg font-bold text-ink group-hover:text-lab-300">{d.shortTitle}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{d.summary}</p>
  <div class="mt-4 flex flex-wrap gap-1.5">
    {d.tools.slice(0, 4).map((t) => <span class="rounded-md border border-line px-2 py-0.5 font-mono text-[11px] text-muted">{t}</span>)}
  </div>
  <div class="mt-5 flex items-center justify-between border-t border-line pt-4 text-sm">
    <span class="text-dim">{d.duration}</span>
    <span class="font-bold text-ink">
      {formatPrice(d.price)}
      {d.originalPrice && <span class="ml-1 text-xs font-normal text-slate-400 line-through">{formatPrice(d.originalPrice)}</span>}
    </span>
  </div>
</a>
