---
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { course: CollectionEntry<'courses'> }
const { course } = Astro.props;
const d = course.data;
---
<a href={`/courses/${course.id}`} class="card group flex flex-col">
  <div class="flex items-start justify-between gap-4">
    <span class="rounded-xl bg-navy-900 p-3 text-lab-400"><Icon name={d.icon} /></span>
    <span class="rounded-full bg-navy-50 px-2.5 py-1 text-xs font-semibold text-navy-700">{d.level}</span>
  </div>
  <h3 class="mt-5 text-lg font-bold text-navy-900 group-hover:text-lab-700">{d.shortTitle}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{d.summary}</p>
  <div class="mt-4 flex flex-wrap gap-1.5">
    {d.tools.slice(0, 4).map((t) => <span class="rounded-md border border-slate-200 px-2 py-0.5 font-mono text-[11px] text-slate-600">{t}</span>)}
  </div>
  <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4 text-sm">
    <span class="text-slate-500">{d.duration}</span>
    <span class="font-bold text-navy-900">
      ${d.price}
      {d.originalPrice && <span class="ml-1 text-xs font-normal text-slate-400 line-through">${d.originalPrice}</span>}
    </span>
  </div>
</a>
