---
import Logo from './Logo.astro';
import { nav } from '../config/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="sticky top-0 z-50 border-b border-line/80 bg-base/80 backdrop-blur">
  <div class="container-x flex h-16 items-center justify-between gap-6">
    <Logo />
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {nav.map((item) => {
        const active = !item.external && (path === item.href || path.startsWith(item.href + '/'));
        return (
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener' : undefined}
            class={`rounded-md px-3 py-2 text-sm font-medium transition ${active ? 'text-ink bg-surface-2' : 'text-muted hover:text-ink hover:bg-white/5'}`}
          >{item.label}{item.external && <span class="ml-1 text-slate-400" aria-hidden="true">↗</span>}</a>
        );
      })}
    </nav>
    <div class="hidden items-center gap-3 lg:flex">
      <a href="/contact" class="text-sm font-medium text-muted hover:text-ink">Contact</a>
      <a href="/courses" class="btn-primary !py-2">Join a batch</a>
    </div>
    <button id="menu-btn" class="rounded-md p-2 text-ink lg:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
  <div id="mobile-menu" class="hidden border-t border-line bg-surface lg:hidden">
    <nav class="container-x flex flex-col py-3" aria-label="Mobile">
      {nav.map((item) => (
        <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined} class="rounded-md px-3 py-3 text-base font-medium text-ink hover:bg-white/5">{item.label}</a>
      ))}
      <a href="/contact" class="rounded-md px-3 py-3 text-base font-medium text-ink hover:bg-white/5">Contact</a>
      <a href="/courses" class="btn-primary mt-2">Join a batch</a>
    </nav>
  </div>
</header>
<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
