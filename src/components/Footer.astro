---
import Logo from './Logo.astro';
import { site } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="bg-surface-2 text-slate-300">
  <div class="container-x grid gap-10 py-14 md:grid-cols-4">
    <div class="md:col-span-1">
      <Logo />
      <p class="mt-4 text-sm leading-relaxed text-slate-400">{site.tagline} Real projects, real problems, and the people who solved them.</p>
      <div class="mt-5 flex gap-3">
        <a href={site.social.youtube} target="_blank" rel="noopener" aria-label="YouTube" class="rounded-md bg-white/5 p-2 hover:bg-white/10"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/></svg></a>
        <a href={site.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="rounded-md bg-white/5 p-2 hover:bg-white/10"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.4 20.4h-3.5v-5.6c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9v5.7H9.4V9h3.4v1.6c.5-.9 1.6-1.9 3.4-1.9 3.6 0 4.3 2.4 4.3 5.5v6.2zM5.3 7.4a2.1 2.1 0 1 1 0-4.1 2.1 2.1 0 0 1 0 4.1zM7.1 20.4H3.6V9h3.5v11.4zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.5c0 1 .8 1.8 1.8 1.8h20.4c1 0 1.8-.8 1.8-1.8V1.7C24 .8 23.2 0 22.2 0z"/></svg></a>
        <a href={site.social.github} target="_blank" rel="noopener" aria-label="GitHub" class="rounded-md bg-white/5 p-2 hover:bg-white/10"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"/></svg></a>
      </div>
    </div>
    <div>
      <h3 class="text-sm font-semibold text-white">Learn</h3>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/library" class="hover:text-white">QA Library</a></li>
        <li><a href="/courses" class="hover:text-white">Courses</a></li>
        <li><a href="/batches" class="hover:text-white">Upcoming batches</a></li>
        <li><a href="/batches#recordings" class="hover:text-white">Free recordings</a></li>
        <li><a href="/resources" class="hover:text-white">Resources</a></li>
        <li><a href="/blog" class="hover:text-white">Blog</a></li>
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-semibold text-white">Courses</h3>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/courses/playwright-typescript-automation" class="hover:text-white">Playwright + TypeScript</a></li>
        <li><a href="/courses/manual-testing-foundations" class="hover:text-white">Manual Testing</a></li>
        <li><a href="/courses/api-testing-postman-playwright" class="hover:text-white">API Testing</a></li>
        <li><a href="/courses/database-testing-sql" class="hover:text-white">Database Testing</a></li>
        <li><a href="/courses/performance-testing-k6-jmeter" class="hover:text-white">Performance Testing</a></li>
        <li><a href="/courses/ai-for-qa-engineers" class="hover:text-white">AI for QA</a></li>
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-semibold text-white">Company</h3>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/about" class="hover:text-white">About</a></li>
        <li><a href={site.interviewUrl} target="_blank" rel="noopener" class="hover:text-white">Interview practice ↗</a></li>
        <li><a href="/contact" class="hover:text-white">Contact</a></li>
        <li><a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-6 text-xs text-dim sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} QA Tech Labs. All rights reserved.</p>
      <p>Built with Astro. Tested, naturally.</p>
    </div>
  </div>
</footer>
